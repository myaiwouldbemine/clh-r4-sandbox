{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIGHT Reviewer Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repository",
    "head",
    "base",
    "builder",
    "reviewer",
    "scope",
    "pr",
    "review_id",
    "verdict"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "builder": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "review_id": {
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED",
        "COMMENTED"
      ]
    }
  }
}
